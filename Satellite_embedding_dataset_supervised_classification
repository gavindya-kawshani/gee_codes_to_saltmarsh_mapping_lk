// ACCURACY ASSESSMENT
// ACCURACY ASSESSMENT (Alpha Earth - Standardized Print Layout)

var validationClassified = validationSamples.classify(classifier);
var errorMatrix = validationClassified.errorMatrix('binary_class', 'classification');

var overallAccuracy = errorMatrix.accuracy();
var kappa           = errorMatrix.kappa();

var confusionArray = errorMatrix.array();
var TN = confusionArray.get([0, 0]);
var FP = confusionArray.get([0, 1]);
var FN = confusionArray.get([1, 0]);
var TP = confusionArray.get([1, 1]);

var PA_nonMarsh = ee.Number(TN).divide(ee.Number(TN).add(FP));
var PA_marsh    = ee.Number(TP).divide(ee.Number(TP).add(FN));
var CA_nonMarsh = ee.Number(TN).divide(ee.Number(TN).add(FN));
var CA_marsh    = ee.Number(TP).divide(ee.Number(TP).add(FP));

var f1_marsh = ee.Number(2).multiply(PA_marsh).multiply(CA_marsh)
  .divide(ee.Number(PA_marsh).add(CA_marsh));

print('=== ACCURACY ASSESSMENT (Alpha Earth) ===');
print('  Overall Accuracy:            ', overallAccuracy);
print('  Kappa Coefficient:           ', kappa);
print('  F1 Score (Saltmarsh):        ', f1_marsh);
print('');
print('  Producer\'s Accuracy:');
print('    - Non-Marsh:               ', PA_nonMarsh);
print('    - Saltmarsh:               ', PA_marsh);
print('');
print('  Consumer\'s Accuracy:');
print('    - Non-Marsh:               ', CA_nonMarsh);
print('    - Saltmarsh:               ', CA_marsh);
print('');
print('  Confusion Matrix:');
print('    - TN:', TN, '  FP:', FP);
print('    - FN:', FN, '  TP:', TP);
// SALTMARSH AREA CALCULATION
var areaImage = refinedClassification.eq(1).multiply(ee.Image.pixelArea());

var stats = areaImage.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: roi,
  scale: 30, // Aligned with other area calculations
  tileScale: 16,
  maxPixels: 1e13,
  bestEffort: true
});

var areaSqM = ee.Number(stats.get('classification'));
var areaHectares = areaSqM.divide(10000);
var areaSqKm    = areaSqM.divide(1000000);

// 3. Wrap results into an unlocated Feature for CSV output
var areaFeature = ee.Feature(null, {
  'Model': 'Alpha Earth Pixel-Based',
  'Area_SqM': areaSqM,
  'Area_Hectares': areaHectares,
  'Area_SqKm': areaSqKm,
  'Scale_m': 30
});

