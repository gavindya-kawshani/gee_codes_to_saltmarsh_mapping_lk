/// DEFINE REGION OF INTEREST (ROI)
var roi = geometry;
Map.centerObject(roi, 8);
Map.addLayer(roi, {color: 'green'}, 'ROI', false);

// DATA PREPARATION & SPLITTING
var dataWithRandom = trainingPolygons.randomColumn({
  columnName: 'random',
  seed: 42
});

var binaryData = dataWithRandom
  .filter(ee.Filter.notNull(['Class']))
  .map(function(feature) {
    var landcover = feature.get('Class');
    var binaryClass = ee.Number(landcover).eq(1).toInt();
    return feature.set('binary_class', binaryClass);
  });

var trainingSet   = binaryData.filter(ee.Filter.lt('random', 0.7));
var validationSet = binaryData.filter(ee.Filter.gte('random', 0.7));

// LOAD ALPHA EARTH EMBEDDINGS
var year = 2024;
var startDate = ee.Date.fromYMD(year, 1, 1);
var endDate = startDate.advance(1, 'year');

var embeddings = ee.ImageCollection('GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL');

var embeddingsImage = embeddings
  .filter(ee.Filter.date(startDate, endDate))
  .filter(ee.Filter.bounds(roi))
  .mosaic();

// ================================
// APPLY ELEVATION MASK (<= 10 m)
// ================================
var srtm = ee.Image('USGS/SRTMGL1_003');
var elevation = srtm.select('elevation');
var elevationMask = elevation.lte(10);

// Mask all areas above 10 m
var embeddingsImage2 = embeddingsImage.updateMask(elevationMask);

var inputBands = embeddingsImage2.bandNames();

// SAMPLE PIXELS FROM EMBEDDINGS (Matched to Pixel/Object methodology)
var trainingSamples = embeddingsImage2.sampleRegions({
  collection: trainingSet,
  properties: ['binary_class'],
  scale: 30,
  tileScale: 16,
  geometries: false
});

var validationSamples = embeddingsImage2.sampleRegions({
  collection: validationSet,
  properties: ['binary_class'],
  scale: 30,
  tileScale: 16,
  geometries: false
});

// TRAIN CLASSIFIER (Single training step)
var classifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  variablesPerSplit: null,
  minLeafPopulation: 5,
  bagFraction: 0.5,
  maxNodes: null,
  seed: 42
}).train({
  features: trainingSamples,
  classProperty: 'binary_class',
  inputProperties: inputBands
});

// CLASSIFICATION & PROBABILITY THRESHOLDING
var clippedComposite = embeddingsImage2.clip(roi);

var probability = clippedComposite.classify(
  classifier.setOutputMode('PROBABILITY')
);

// Reset classifier back to CLASSIFICATION mode for validation
classifier = classifier.setOutputMode('CLASSIFICATION');

// Refine classification (>= 80% probability)
var refinedClassification = probability.gte(0.80).rename('classification');

// VISUALIZATION
var saltmarshOnly = refinedClassification.eq(1).selfMask();
Map.addLayer(saltmarshOnly, {palette: ['red']}, 'Alpha Earth Saltmarsh');

