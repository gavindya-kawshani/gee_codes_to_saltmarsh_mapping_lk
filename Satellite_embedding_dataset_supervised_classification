var trainSaltmarshPolygons    = trainingSet.filter(ee.Filter.eq('binary_class', 1));
var trainNonSaltmarshPolygons = trainingSet.filter(ee.Filter.eq('binary_class', 0));
var trainPixelsSaltmarsh    = trainingSamples.filter(ee.Filter.eq('binary_class', 1));
var trainPixelsNonSaltmarsh = trainingSamples.filter(ee.Filter.eq('binary_class', 0));

print('=== TRAINING DATASET SUMMARY ===');
print('  Training Polygons:');
print('    - Saltmarsh:               ', trainSaltmarshPolygons.size());
print('    - Non-Saltmarsh:           ', trainNonSaltmarshPolygons.size());
print('');
print('  Training Pixel Samples:');
print('    - Saltmarsh:               ', trainPixelsSaltmarsh.size());
print('    - Non-Saltmarsh:           ', trainPixelsNonSaltmarsh.size());
print('    - Total:                   ', trainingSamples.size());

// VALIDATION DATA SUMMARY
var valSaltmarshPolygons    = validationSet.filter(ee.Filter.eq('binary_class', 1));
var valNonSaltmarshPolygons = validationSet.filter(ee.Filter.eq('binary_class', 0));
var valPixelsSaltmarsh    = validationSamples.filter(ee.Filter.eq('binary_class', 1));
var valPixelsNonSaltmarsh = validationSamples.filter(ee.Filter.eq('binary_class', 0));

print('=== VALIDATION DATASET SUMMARY ===');
print('  Validation Polygons:');
print('    - Saltmarsh:               ', valSaltmarshPolygons.size());
print('    - Non-Saltmarsh:           ', valNonSaltmarshPolygons.size());
print('');
print('  Validation Pixel Samples:');
print('    - Saltmarsh:               ', valPixelsSaltmarsh.size());
print('    - Non-Saltmarsh:           ', valPixelsNonSaltmarsh.size());
print('    - Total:                   ', validationSamples.size());


