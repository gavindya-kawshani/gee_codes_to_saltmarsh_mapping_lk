
// DEFINE REGION OF INTEREST (ROI)
var roi = geometry;
//
Map.centerObject(roi, 8);
Map.addLayer(roi, {color: 'green'}, 'ROI', false);


// DATA SPLITTING

var dataWithRandom = trainingPolygons.randomColumn({
  columnName: 'random',
  seed: 42
});

var binaryData = dataWithRandom
  .filter(ee.Filter.notNull(['Class']))
  .map(function(feature) {
    var landcover = ee.Number(feature.get('Class'));
    var binaryClass = landcover.eq(1).toInt();
    return feature.set('binary_class', binaryClass);
  });

// Split data: 70% training, 30% validation
var trainingSet   = binaryData.filter(ee.Filter.lt('random', 0.7));
var validationSet = binaryData.filter(ee.Filter.gte('random', 0.7));


// SAMPLE PIXELS FROM COMPOSITE

// SAMPLE PIXELS FROM COMPOSITE

var inputBands = objectBasedComposite.bandNames();

var trainingSamples = objectBasedComposite.sampleRegions({
  collection: trainingSet,
  properties: ['binary_class'],
  scale: 30, 
  tileScale: 16,
  geometries: false
})


var validationSamples = objectBasedComposite.sampleRegions({
  collection: validationSet,
  properties: ['binary_class'],
  scale: 30,
  tileScale: 16,
  geometries: false
})

// TRAIN CLASSIFIER - Random Forest

var classifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  variablesPerSplit: null,
  minLeafPopulation: 5,
  bagFraction: 0.5,
  maxNodes: null,
  seed: 42
}).train({
  features: trainingSamples,
  classProperty: 'binary_class',
  inputProperties: inputBands
});


// OBJECT-BASED CLASSIFICATION

//Clip to ROI first
var clippedComposite = objectBasedComposite.clip(roi);

// Single classify() pass
var probability = clippedComposite.classify(
  classifier.setOutputMode('PROBABILITY')
);
classifier = classifier.setOutputMode('CLASSIFICATION');

// POST-PROCESSING AND REFINEMENT

var refinedClassification = probability.gte(0.8).rename('classification');

// VISUALIZATION

var displayImage = refinedClassification;

// Map.addLayer(displayImage,
//   {min: 0, max: 1, palette: ['gray', 'red']},
//   'Final Tidal Marsh Classification (Object-Based)');
  
//Visualize saltmarsh only
var saltmarshOnly = refinedClassification.eq(1).selfMask();

Map.addLayer(
  saltmarshOnly,
  {palette: ['red']},
  'Saltmarsh Only'
);

